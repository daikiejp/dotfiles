# ==============================================================================
# Zsh Environments
# DaikieJP - 2026
# Generated by chezmoi — edit it in the repo: home/dot_config/zsh/env.zsh.tmpl
# ==============================================================================

# ==============================================================================
# Homebrew
# Runtime detection: Apple Silicon, Intel or Linuxbrew.
# Se hace a mano en vez de `brew shellenv` porque eso cuesta ~50ms de arranque.
# ==============================================================================

for _brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew"; do
  if [[ -x "$_brew_prefix/bin/brew" ]]; then
    export HOMEBREW_PREFIX="$_brew_prefix"
    export HOMEBREW_CELLAR="$_brew_prefix/Cellar"
    export HOMEBREW_REPOSITORY="$_brew_prefix"
    export MANPATH="$_brew_prefix/share/man${MANPATH+:$MANPATH}:"
    export INFOPATH="$_brew_prefix/share/info${INFOPATH:+:$INFOPATH}"
    break
  fi
done
unset _brew_prefix

# ==============================================================================
# PATH
# ==============================================================================

typeset -U path
path=(
  ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/bin}
  ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/sbin}
  $HOME/.local/bin
  $HOME/bin
  $path
)
export PATH

# ==============================================================================
# Language
# ==============================================================================

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ==============================================================================
# Editor & Pager
# ==============================================================================

export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-R -F -X"

# ==============================================================================
# Colors
# ==============================================================================

export CLICOLOR=1
{{ if eq .chezmoi.os "darwin" -}}
export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd
{{- else -}}
export LS_COLORS='di=1;34:ln=1;36:so=1;35:pi=1;33:ex=1;32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=34;43'
{{- end }}

# ==============================================================================
# GPG
# ==============================================================================

export GPG_TTY=$TTY

# ==============================================================================
# History
# ==============================================================================

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000000

setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# ==============================================================================
# History Search
# ==============================================================================

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search

zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

# ==============================================================================
# Zoxide
# ==============================================================================

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# ==============================================================================
# FZF
# ==============================================================================

export FZF_DEFAULT_OPTS="
  --height 40%
  --layout=reverse
  --border
  --preview 'bat --style=numbers --color=always {} 2>/dev/null || cat {}'
  --preview-window right:60%
"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
{{ if ne .chezmoi.os "darwin" }}
# Debian installs the fzf bindings here
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
{{- end }}

# ==============================================================================
# Tmux
# Auto-attach only in genuinely interactive shells. Skipped inside the VS Code
# / devcontainer terminal, where nesting it breaks the session.
# ==============================================================================

if [[ -z "$TMUX" ]] \
  && [[ -o interactive ]] \
  && [[ -z "$VSCODE_INJECTION" ]] \
  && [[ -z "$INSIDE_EMACS" ]] \
  && [[ "$TERM_PROGRAM" != "vscode" ]] \
  && command -v tmux >/dev/null 2>&1; then
  tmux attach -t main || tmux new -s main
fi

# ==============================================================================
# Starship
# ==============================================================================

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# ==============================================================================
# Runtimes - mise
# Replaces nvm, rbenv and rustup. Versions are pinned in
# ~/.config/mise/config.toml, so every machine ends up on the same ones.
# ==============================================================================

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# ==============================================================================
# Node - Pnpm
# ==============================================================================

{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="$HOME/Library/pnpm"
{{- else -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{- end }}
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ==============================================================================
# Rust - Cargo
# mise installs the toolchain through rustup; this only puts binaries built
# with `cargo install` on the PATH.
# ==============================================================================

[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
