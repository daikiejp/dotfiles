{{- if and .installPackages (eq .family "darwin") -}}
#!/bin/bash
# ==============================================================================
# macOS packages (Homebrew)
# DaikieJP - 2026
# Generated by chezmoi from .chezmoidata.yaml — do not edit by hand.
# ==============================================================================

set -euo pipefail

echo "🍎 macOS: checking Homebrew and packages..."

# ------------------------------------------------------------------------------
# Homebrew
# ------------------------------------------------------------------------------
if ! command -v brew >/dev/null 2>&1; then
  echo "📦 Homebrew not found. Installing..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# The prefix differs between Apple Silicon and Intel
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
else
  echo "❌ Could not locate brew after installing it." >&2
  exit 1
fi

# ------------------------------------------------------------------------------
# Brewfile
#
# Best-effort on purpose: if a cask fails (typical with fonts already
# installed by hand in ~/Library/Fonts) we warn but do NOT abort. Otherwise a
# single conflicting package would stop the dotfiles from being applied and
# the later scripts from running.
# ------------------------------------------------------------------------------
echo "📦 Applying Brewfile..."

BUNDLE_LOG="$(mktemp)"
trap 'rm -f "$BUNDLE_LOG"' EXIT

if brew bundle --file=/dev/stdin 2>&1 <<'BREWFILE' | tee "$BUNDLE_LOG"
{{ range .packages.darwin.taps -}}
tap "{{ . }}"
{{ end -}}
{{ range .packages.darwin.brews -}}
brew "{{ . }}"
{{ end -}}
{{- if $.gui }}
{{ range .packages.darwin.gui_brews -}}
brew "{{ . }}"
{{ end -}}
{{ range .packages.darwin.casks -}}
cask "{{ . }}"
{{ end -}}
{{- end }}
BREWFILE
then
  echo "✅ macOS packages ready."
else
  echo ""
  echo "⚠️  brew bundle finished with errors. What failed:"
  grep -iE 'has failed|^Error:' "$BUNDLE_LOG" | sed 's/^/     /' || true
  echo ""
  echo "   The rest of the install continues. Typical cases:"
  echo "   • Font already installed by hand →  brew install --cask --force <cask>"
  echo "   • Cask that needs permissions →  install it yourself and re-apply"
  echo ""
fi
{{- end -}}
