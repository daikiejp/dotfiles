#!/bin/bash
# ==============================================================================
# Zsh as the default shell
# DaikieJP - 2026
# ==============================================================================

set -euo pipefail

ZSH_BIN="$(command -v zsh || true)"
[ -n "$ZSH_BIN" ] || exit 0

# ------------------------------------------------------------------------------
# Current login shell.
# Careful: getent does not exist on macOS, so this has to branch.
# ------------------------------------------------------------------------------
current_shell() {
  if command -v dscl >/dev/null 2>&1; then          # macOS
    dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null | awk '{print $2}'
  elif command -v getent >/dev/null 2>&1; then      # Linux
    getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7
  else
    echo "${SHELL:-}"
  fi
}

CURRENT="$(current_shell)"

# If the login shell is already some zsh, leave it alone. Whether it is
# /bin/zsh or Homebrew's does not matter: switching between them is not worth
# a password prompt on every new machine.
case "$CURRENT" in
  */zsh) echo "✅ Zsh is already the default shell ($CURRENT)."; exit 0 ;;
esac

{{ if .headless -}}
# Containers and CI have no tty for chsh, and it is not worth it there.
echo "ℹ️  Headless machine: shell left alone (do it with: chsh -s $ZSH_BIN)."
exit 0
{{ end -}}

# ------------------------------------------------------------------------------
# chsh only accepts shells listed in /etc/shells.
# We use sudo -n: if a password is needed we warn instead of blocking the apply.
# ------------------------------------------------------------------------------
if ! grep -qxF "$ZSH_BIN" /etc/shells 2>/dev/null; then
  if sudo -n true 2>/dev/null; then
    echo "$ZSH_BIN" | sudo -n tee -a /etc/shells >/dev/null
  else
    echo "⚠️  $ZSH_BIN is not in /etc/shells and sudo wants a password."
    echo "   Do it by hand:"
    echo "     echo $ZSH_BIN | sudo tee -a /etc/shells"
    echo "     chsh -s $ZSH_BIN"
    exit 0
  fi
fi

echo "🐚 Setting Zsh as the default shell..."
if ! chsh -s "$ZSH_BIN"; then
  echo "⚠️  chsh failed. Do it by hand: chsh -s $ZSH_BIN"
fi
