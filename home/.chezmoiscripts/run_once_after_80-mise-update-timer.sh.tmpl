{{- if not .headless -}}
#!/bin/bash
# ==============================================================================
# Schedule the weekly runtime upgrade
# DaikieJP - 2026
#
# The unit files themselves are deployed by chezmoi; this only registers them
# with launchd or systemd, once per machine.
# ==============================================================================

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
PLIST="$HOME/Library/LaunchAgents/com.daikiejp.mise-update.plist"
LABEL="com.daikiejp.mise-update"

[ -f "$PLIST" ] || exit 0

# Already registered? Re-register so an edited plist takes effect.
if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
  launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
fi

if launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null; then
  echo "⏰ Weekly runtime upgrade scheduled (Sundays at 03:00)."
else
  echo "⚠️  Could not register the launchd agent. Do it by hand:"
  echo "     launchctl bootstrap gui/\$(id -u) $PLIST"
fi
{{- else -}}
command -v systemctl >/dev/null 2>&1 || exit 0

# No systemd inside plain containers
systemctl --user show-environment >/dev/null 2>&1 || exit 0

if systemctl --user enable --now mise-update.timer 2>/dev/null; then
  echo "⏰ Weekly runtime upgrade scheduled (Sundays at 03:00)."
else
  echo "⚠️  Could not enable the timer. Do it by hand:"
  echo "     systemctl --user enable --now mise-update.timer"
fi
{{- end }}
{{- end -}}
