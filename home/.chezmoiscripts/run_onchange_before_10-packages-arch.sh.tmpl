{{- if and .installPackages (eq .family "arch") -}}
#!/bin/bash
# ==============================================================================
# Arch Linux packages
# DaikieJP - 2026
# Generated by chezmoi from .chezmoidata.yaml — do not edit by hand.
# ==============================================================================

set -euo pipefail

echo "🏔️  Arch: installing packages..."

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
  else
    echo "❌ sudo (or running as root) is required to install packages." >&2
    exit 1
  fi
fi

$SUDO pacman -Sy --needed --noconfirm \
{{ range $i, $p := .packages.arch.pacman }}{{ if $i }} \
{{ end }}  {{ $p }}{{ end }}
{{- if .gui }}

# Fonts (GUI only)
$SUDO pacman -S --needed --noconfirm \
{{ range $i, $p := .packages.arch.gui_pacman }}{{ if $i }} \
{{ end }}  {{ $p }}{{ end }}
{{- end }}

echo "✅ Arch packages ready."
{{- end -}}
