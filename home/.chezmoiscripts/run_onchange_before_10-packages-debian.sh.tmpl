{{- if and .installPackages (eq .family "debian") -}}
#!/bin/bash
# ==============================================================================
# Debian / Ubuntu packages
# DaikieJP - 2026
# Generated by chezmoi from .chezmoidata.yaml — do not edit by hand.
# ==============================================================================

set -euo pipefail

echo "🐧 Debian/Ubuntu: installing packages..."

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
  else
    echo "❌ sudo (or running as root) is required to install packages." >&2
    exit 1
  fi
fi

BIN="$HOME/.local/bin"
mkdir -p "$BIN"
export PATH="$BIN:$PATH"

# ------------------------------------------------------------------------------
# apt
# ------------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
$SUDO apt-get update -qq
$SUDO apt-get install -y --no-install-recommends \
{{ range $i, $p := .packages.debian.apt }}{{ if $i }} \
{{ end }}  {{ $p }}{{ end }}

{{- if .gui }}

# ------------------------------------------------------------------------------
# GUI packages
# Best-effort: Alacritty is not in every Debian/Ubuntu release, and a missing
# package must not abort the whole apply.
# ------------------------------------------------------------------------------
for p in {{ range .packages.debian.gui_apt }}{{ . }} {{ end }}; do
  if ! $SUDO apt-get install -y --no-install-recommends "$p" 2>/dev/null; then
    echo "⚠️  $p is not in this release's repos; install it by hand."
  fi
done
{{- end }}

# ------------------------------------------------------------------------------
# Aliases for binaries Debian renames
# ------------------------------------------------------------------------------
[ -x /usr/bin/batcat ] && ln -sf /usr/bin/batcat "$BIN/bat"
[ -x /usr/bin/fdfind ] && ln -sf /usr/bin/fdfind "$BIN/fd"

# ==============================================================================
# Extras that are not in apt, or whose version there is too old.
#
# From here on everything is best-effort: if a download fails we warn but do
# NOT abort, so that a network hiccup does not stop the dotfiles from being
# applied or the later scripts from running. The apt packages above are
# mandatory and do abort.
# ==============================================================================

FAILED=""

# ------------------------------------------------------------------------------
# Neovim — the apt version is too old for the config
# ------------------------------------------------------------------------------
install_neovim() {
  local arch tmp
  case "$(uname -m)" in
    x86_64)  arch="linux-x86_64" ;;
    aarch64) arch="linux-arm64"  ;;
    *) echo "⚠️  $(uname -m) has no official Neovim build; skipping."; return 0 ;;
  esac

  echo "📦 Installing Neovim (stable release)..."
  tmp="$(mktemp -d)"

  if curl -fsSL "https://github.com/neovim/neovim/releases/download/stable/nvim-${arch}.tar.gz" \
       | tar -xz -C "$tmp" --strip-components=1; then
    mkdir -p "$HOME/.local"
    cp -R "$tmp"/* "$HOME/.local/"
    rm -rf "$tmp"
  else
    rm -rf "$tmp"
    return 1
  fi
}

# ------------------------------------------------------------------------------
# Starship
# ------------------------------------------------------------------------------
install_starship() {
  echo "📦 Installing Starship..."
  curl -fsSL https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$BIN"
}

# ------------------------------------------------------------------------------
# Zoxide
# ------------------------------------------------------------------------------
install_zoxide() {
  echo "📦 Installing zoxide..."
  curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh \
    | sh -s -- --bin-dir "$BIN"
}

# ------------------------------------------------------------------------------
# Eza — in apt since Ubuntu 24.04; on older releases, the official repo
# ------------------------------------------------------------------------------
install_eza() {
  if apt-cache show eza >/dev/null 2>&1; then
    $SUDO apt-get install -y --no-install-recommends eza
    return
  fi

  echo "📦 Installing eza from the official repo..."
  $SUDO mkdir -p /etc/apt/keyrings
  curl -fsSL https://raw.githubusercontent.com/eza-community/eza/main/deb.asc \
    | $SUDO gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
  echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" \
    | $SUDO tee /etc/apt/sources.list.d/gierens.list >/dev/null
  $SUDO chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
  $SUDO apt-get update -qq
  $SUDO apt-get install -y --no-install-recommends eza
}

# ------------------------------------------------------------------------------
# mise — owns the language runtimes; not packaged in apt
# ------------------------------------------------------------------------------
install_mise() {
  echo "📦 Installing mise..."
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$BIN/mise" sh
}

for tool in neovim starship zoxide eza mise; do
  # The neovim binary is called nvim
  bin="$tool"; [ "$tool" = "neovim" ] && bin="nvim"

  command -v "$bin" >/dev/null 2>&1 && continue

  if ! "install_$tool"; then
    echo "⚠️  Failed to install $tool." >&2
    FAILED="$FAILED $tool"
  fi
done

if [ -n "$FAILED" ]; then
  echo ""
  echo "⚠️  Could not install:$FAILED"
  echo "   Everything else is ready. To retry:"
  echo "     chezmoi state delete-bucket --bucket=scriptState && chezmoi apply"
  echo ""
else
  echo "✅ Debian/Ubuntu packages ready."
fi
{{- end -}}
